---
import { basics as basics_es } from "@cv"
import { basics as basics_en } from "@cv_en"
import 'src/styles.scss';

interface Props {
  title: string
}

const { title } = Astro.props

const { image, url } = basics_es

const seoDescription_es = "Frontend Developer con más de 10 años de experiencia en React, Vue, Astro, Webflow y Shopify. Especializado en UX, rendimiento web y SEO técnico."
const seoDescription_en = "Frontend Developer with over 10 years of experience in React, Vue, Astro, Webflow and Shopify. Specialized in UX, web performance and technical SEO."
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MTD6TJZT');
  </script>
    <title>{title}</title>

    <!-- SEO: descripción corta estática, no el summary largo -->
    <meta name="description" content={seoDescription_es} />
    <meta name="viewport" content="width=device-width" />
    <meta name="app-impact" content="Impact-Site-Verification: ca95245b-35e2-4deb-9f77-aa3a95c05161" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="image" href={image} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={seoDescription_es} />
    <meta property="og:image" content="/me.webp" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content={url.split("//")[1] ?? ''} />
    <meta property="twitter:url" content={url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={seoDescription_es} />
    <meta name="twitter:image" content="/me.webp" />

    

    <!-- Cambia description y lang según idioma del usuario -->
    <script is:inline define:vars={{ seoDescription_es, seoDescription_en }}>
      (function() {
        const saved = localStorage.getItem("cv-lang");
        const browser = navigator.language.toLowerCase().startsWith("es") ? "es" : "en";
        const lang = saved || browser;

        document.documentElement.setAttribute("data-lang", lang);
        document.documentElement.setAttribute("lang", lang);

        // Actualiza meta description según idioma
        const desc = lang === "en" ? seoDescription_en : seoDescription_es;
        document.querySelector('meta[name="description"]')?.setAttribute("content", desc);
        document.querySelector('meta[property="og:description"]')?.setAttribute("content", desc);
        document.querySelector('meta[name="twitter:description"]')?.setAttribute("content", desc);
      })();
    </script>
  </head>
  <body>
    <noscript>
      <iframe 
        src="https://www.googletagmanager.com/ns.html?id=GTM-MTD6TJZT"
        height="0" 
        width="0" 
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <slot />
  </body>
</html>

<style is:global>
  html {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      "Courier New",
      Courier,
      monospace;
    background: #fff;
    letter-spacing: -0.025rem;
  }

  body,
  figure {
    margin: 0;
    padding: 0;
  }

  a {
    text-decoration: none;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  h1,
  h2,
  h3,
  h4 {
    margin: 0;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      "Open Sans",
      "Helvetica Neue",
      sans-serif;
  }

  p {
    color: #666;
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    text-wrap: pretty;
  }

  .print {
    display: none !important;
  }

  /* Language switching */
  [data-lang-content="es"],
  [data-lang-content="en"] {
    display: none !important;
  }

  html[data-lang="es"] [data-lang-content="es"] {
    display: revert !important;
  }

  html[data-lang="en"] [data-lang-content="en"] {
    display: revert !important;
  }

  html[data-lang="es"] .projects-grid[data-lang-content="es"],
  html[data-lang="en"] .projects-grid[data-lang-content="en"] {
    display: grid !important;
  }

  html[data-lang="es"] .work-list[data-lang-content="es"],
  html[data-lang="en"] .work-list[data-lang-content="en"] {
    display: flex !important;
    flex-wrap: wrap;
    flex-direction: column;
    gap: 40px;
  }

  html[data-lang="es"] .data-skills[data-lang-content="es"],
  html[data-lang="en"] .data-skills[data-lang-content="en"] {
    display: flex !important;
    gap: 8px;
  }

  @media print {
    .no-print {
      display: none !important;
    }

    .print {
      display: block !important;
    }

    astro-dev-toolbar {
      display: none !important;
    }

    article {
      break-inside: avoid;
    }
  }
</style>