---
import { basics as basics_es } from "@cv"
import 'src/styles.scss';
import ThemeToggle from "../components/ThemeToggle.astro";


interface Props {
  title: string
}

const { title } = Astro.props

const { image, url } = basics_es

const seoDescription_es = "Frontend Developer con más de 10 años de experiencia en React, Vue, Astro, Webflow y Shopify. Especializado en UX, rendimiento web y SEO técnico."
const seoDescription_en = "Frontend Developer with over 10 years of experience in React, Vue, Astro, Webflow and Shopify. Specialized in UX, web performance and technical SEO."
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MTD6TJZT');
    </script>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-W1Q1L41MZ3"></script>
    <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); } gtag('js', new Date());
    gtag('config', 'G-W1Q1L41MZ3');
    </script>
    <title>{title}</title>

    <!-- SEO: descripción corta estática, no el summary largo -->
    <meta name="description" content={seoDescription_es} />
    <meta name="viewport" content="width=device-width" />
    <meta name="app-impact" content="Impact-Site-Verification: ca95245b-35e2-4deb-9f77-aa3a95c05161" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="image" href={image} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={seoDescription_es} />
    <meta property="og:image" content="/me.webp" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content={url.split("//")[1] ?? ''} />
    <meta property="twitter:url" content={url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={seoDescription_es} />
    <meta name="twitter:image" content="/me.webp" />

    

    <!-- Tema claro/oscuro: se aplica antes del primer paint para evitar parpadeo -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem("cv-theme");
        const theme = saved || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>

    <!-- Cambia description y lang según idioma del usuario -->
    <script is:inline define:vars={{ seoDescription_es, seoDescription_en }}>
      (function() {
        const saved = localStorage.getItem("cv-lang");
        const browser = navigator.language.toLowerCase().startsWith("es") ? "es" : "en";
        const lang = saved || browser;

        document.documentElement.setAttribute("data-lang", lang);
        document.documentElement.setAttribute("lang", lang);

        // Actualiza meta description según idioma
        const desc = lang === "en" ? seoDescription_en : seoDescription_es;
        document.querySelector('meta[name="description"]')?.setAttribute("content", desc);
        document.querySelector('meta[property="og:description"]')?.setAttribute("content", desc);
        document.querySelector('meta[name="twitter:description"]')?.setAttribute("content", desc);
      })();
    </script>
  </head>
  <body>
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-MTD6TJZT"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <ThemeToggle />
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #fff;
    --surface: rgba(255, 255, 255, 0.9);
    --surface-alt: #fdfdfd;
    --border: #eee;
    --border-strong: #ddd;
    --text-primary: #111;
    --text-heading: #101010;
    --text-body: #666;
    --text-muted: #555;
    --text-faint: #999;
    --text-faintest: #ccc;
    --chip-bg: #eee;
    --chip-text: #444;
    --card-border: #f2f2f2;
    --icon-stroke: #777;
    --glass-bg: rgba(255, 255, 255, 0.55);
    --glass-border: rgba(255, 255, 255, 0.6);
    --glass-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  [data-theme="dark"] {
    --bg: #111214;
    --surface: rgba(24, 25, 28, 0.9);
    --surface-alt: #1a1b1e;
    --border: #2a2b2e;
    --border-strong: #3a3b3e;
    --text-primary: #f2f2f2;
    --text-heading: #f0f0f0;
    --text-body: #b3b3b3;
    --text-muted: #999;
    --text-faint: #888;
    --text-faintest: #555;
    --chip-bg: #2a2b2e;
    --chip-text: #ccc;
    --card-border: #2a2b2e;
    --icon-stroke: #aaa;
    --glass-bg: rgba(24, 25, 28, 0.45);
    --glass-border: rgba(255, 255, 255, 0.12);
    --glass-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
  }

  html {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      "Courier New",
      Courier,
      monospace;
    background: var(--bg);
    color: var(--text-primary);
    letter-spacing: -0.025rem;
    transition: background 0.2s ease, color 0.2s ease;
  }

  body,
  figure {
    margin: 0;
    padding: 0;
  }

  a {
    text-decoration: none;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  h1,
  h2,
  h3,
  h4 {
    margin: 0;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      "Open Sans",
      "Helvetica Neue",
      sans-serif;
  }

  p {
    color: var(--text-body);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    text-wrap: pretty;
  }

  .print {
    display: none !important;
  }

  /* Language switching */
  [data-lang-content="es"],
  [data-lang-content="en"] {
    display: none !important;
  }

  html[data-lang="es"] [data-lang-content="es"] {
    display: revert !important;
  }

  html[data-lang="en"] [data-lang-content="en"] {
    display: revert !important;
  }

  html[data-lang="es"] .projects-grid[data-lang-content="es"],
  html[data-lang="en"] .projects-grid[data-lang-content="en"] {
    display: grid !important;
  }

  html[data-lang="es"] .work-list[data-lang-content="es"],
  html[data-lang="en"] .work-list[data-lang-content="en"] {
    display: flex !important;
    flex-wrap: wrap;
    flex-direction: column;
    gap: 40px;
  }

  html[data-lang="es"] .data-skills[data-lang-content="es"],
  html[data-lang="en"] .data-skills[data-lang-content="en"] {
    display: flex !important;
    gap: 8px;
  }

  @media print {
    .no-print {
      display: none !important;
    }

    .print {
      display: block !important;
    }

    astro-dev-toolbar {
      display: none !important;
    }

    article {
      break-inside: avoid;
    }
  }
</style>
