---
import { basics as basics_es, projects, skills } from "@cv"
import { basics as basics_en } from "@cv_en"
import { seoDescriptions } from "@/lib/seo"
import 'src/styles.scss';
import ThemeToggle from "../components/ThemeToggle.astro";


interface Props {
  title: string
}

const { title } = Astro.props

const { image } = basics_es

if (!Astro.site) throw new Error("Astro.site is required for canonical URLs")
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href
const imageUrl = new URL(image, Astro.site).href
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${canonicalUrl}#profile`,
  url: canonicalUrl,
  inLanguage: ["es", "en"],
  mainEntity: {
    "@type": "Person",
    "@id": `${canonicalUrl}#person`,
    name: basics_es.name,
    url: canonicalUrl,
    image: imageUrl,
    jobTitle: [
      { "@value": basics_es.label, "@language": "es" },
      { "@value": basics_en.label, "@language": "en" },
    ],
    description: [
      { "@value": basics_es.summary, "@language": "es" },
      { "@value": basics_en.summary, "@language": "en" },
    ],
    knowsAbout: [...new Set([...skills.map(({ name }) => name), "E-commerce", "UX/UI", "Web Performance", "SEO técnico"])],
    sameAs: basics_es.profiles.map(({ url }) => url),
  },
  mentions: projects.map(({ name, description, url }) => ({
    "@type": "CreativeWork",
    name,
    description,
    url,
  })),
}
---

<!doctype html>
<html lang="es" data-lang="es">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MTD6TJZT');
    </script>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-W1Q1L41MZ3"></script>
    <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); } gtag('js', new Date());
    gtag('config', 'G-W1Q1L41MZ3');
    </script>
    <title>{title}</title>

    <!-- SEO: descripción corta estática, no el summary largo -->
    <meta name="description" content={seoDescriptions.es} />
    <meta name="robots" content="index, follow" />
    <meta name="viewport" content="width=device-width" />
    <meta name="app-impact" content="Impact-Site-Verification: ca95245b-35e2-4deb-9f77-aa3a95c05161" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="image" href={image} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />

    <!-- Open Graph -->
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={seoDescriptions.es} />
    <meta property="og:image" content={imageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content={Astro.site.host} />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={seoDescriptions.es} />
    <meta name="twitter:image" content={imageUrl} />

    

    <!-- Tema claro/oscuro: se aplica antes del primer paint para evitar parpadeo -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem("cv-theme");
        const theme = saved || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>

    <!-- Cambia description y lang según idioma del usuario -->
    <script is:inline define:vars={{ seoDescriptions }}>
      (function() {
        const saved = localStorage.getItem("cv-lang");
        const browser = navigator.language.toLowerCase().startsWith("es") ? "es" : "en";
        const lang = saved === "es" || saved === "en" ? saved : browser;

        document.documentElement.setAttribute("data-lang", lang);
        document.documentElement.setAttribute("lang", lang);

        // Actualiza meta description según idioma
        const desc = seoDescriptions[lang];
        document.querySelector('meta[name="description"]')?.setAttribute("content", desc);
        document.querySelector('meta[property="og:description"]')?.setAttribute("content", desc);
        document.querySelector('meta[name="twitter:description"]')?.setAttribute("content", desc);
      })();
    </script>
  </head>
  <body>
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-MTD6TJZT"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <ThemeToggle />
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #fff;
    --surface: rgba(255, 255, 255, 0.9);
    --surface-alt: #fdfdfd;
    --border: #eee;
    --border-strong: #ddd;
    --text-primary: #111;
    --text-heading: #101010;
    --text-body: #666;
    --text-muted: #555;
    --text-faint: #999;
    --text-faintest: #ccc;
    --chip-bg: #eee;
    --chip-text: #444;
    --card-border: #f2f2f2;
    --icon-stroke: #777;
    --glass-bg: rgba(255, 255, 255, 0.55);
    --glass-border: rgba(255, 255, 255, 0.6);
    --glass-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  [data-theme="dark"] {
    --bg: #111214;
    --surface: rgba(24, 25, 28, 0.9);
    --surface-alt: #1a1b1e;
    --border: #2a2b2e;
    --border-strong: #3a3b3e;
    --text-primary: #f2f2f2;
    --text-heading: #f0f0f0;
    --text-body: #b3b3b3;
    --text-muted: #999;
    --text-faint: #888;
    --text-faintest: #555;
    --chip-bg: #2a2b2e;
    --chip-text: #ccc;
    --card-border: #2a2b2e;
    --icon-stroke: #aaa;
    --glass-bg: rgba(24, 25, 28, 0.45);
    --glass-border: rgba(255, 255, 255, 0.12);
    --glass-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
  }

  html {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      "Courier New",
      Courier,
      monospace;
    background: var(--bg);
    color: var(--text-primary);
    letter-spacing: -0.025rem;
    transition: background 0.2s ease, color 0.2s ease;
  }

  body,
  figure {
    margin: 0;
    padding: 0;
  }

  a {
    text-decoration: none;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  h1,
  h2,
  h3,
  h4 {
    margin: 0;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      "Open Sans",
      "Helvetica Neue",
      sans-serif;
  }

  p {
    color: var(--text-body);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    text-wrap: pretty;
  }

  .print {
    display: none !important;
  }

  /* Language switching */
  [data-lang-content="es"],
  [data-lang-content="en"] {
    display: none !important;
  }

  html[data-lang="es"] [data-lang-content="es"] {
    display: revert !important;
  }

  html[data-lang="en"] [data-lang-content="en"] {
    display: revert !important;
  }

  html[data-lang="es"] .projects-grid[data-lang-content="es"],
  html[data-lang="en"] .projects-grid[data-lang-content="en"] {
    display: grid !important;
  }

  html[data-lang="es"] .work-list[data-lang-content="es"],
  html[data-lang="en"] .work-list[data-lang-content="en"] {
    display: flex !important;
    flex-wrap: wrap;
    flex-direction: column;
    gap: 40px;
  }

  html[data-lang="es"] .data-skills[data-lang-content="es"],
  html[data-lang="en"] .data-skills[data-lang-content="en"] {
    display: flex !important;
    gap: 8px;
  }

  @media print {
    .no-print {
      display: none !important;
    }

    .print {
      display: block !important;
    }

    astro-dev-toolbar {
      display: none !important;
    }

    article {
      break-inside: avoid;
    }
  }
</style>
