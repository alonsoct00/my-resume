---
---

<button
  id="theme-toggle"
  class="theme-toggle no-print"
  type="button"
  aria-label="Cambiar tema claro/oscuro"
  title="Cambiar tema"
>
  <svg class="icon icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
  <svg class="icon icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
  </svg>
</button>

<script>
  type Theme = "light" | "dark";

  const button = document.getElementById("theme-toggle") as HTMLButtonElement;
  const htmlElement = document.documentElement;

  const getTheme = (): Theme =>
    (htmlElement.getAttribute("data-theme") as Theme) || "light";

  const applyTheme = (theme: Theme): void => {
    htmlElement.setAttribute("data-theme", theme);
    localStorage.setItem("cv-theme", theme);
  };

  const switchTheme = (): void => {
    applyTheme(getTheme() === "dark" ? "light" : "dark");
  };

  button.addEventListener("click", () => {
    if (!document.startViewTransition) {
      switchTheme();
      return;
    }
    document.startViewTransition(switchTheme);
  });
</script>

<style is:global>
  ::view-transition-group(root) {
    animation-timing-function: var(--expo-out);
  }

  ::view-transition-old(root) {
    animation: none;
    animation-fill-mode: both;
    z-index: -1;
  }

  ::view-transition-new(root) {
    mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40"><circle cx="20" cy="20" r="20" fill="white"/></svg>') center / 0 no-repeat;
    animation: theme-toggle-scale 0.6s;
    animation-fill-mode: both;
  }

  @keyframes theme-toggle-scale {
    to {
      mask-size: 250vmax;
    }
  }

  :root {
    --expo-out: linear(
      0 0%, 0.1684 2.66%, 0.3165 5.49%,
      0.446 8.52%, 0.5581 11.78%,
      0.6535 15.29%, 0.7341 19.11%,
      0.8011 23.3%, 0.8557 27.93%,
      0.8962 32.68%, 0.9283 38.01%,
      0.9529 44.08%, 0.9711 51.14%,
      0.9833 59.06%, 0.9915 68.74%, 1 100%
    );
  }
</style>

<style>
  .theme-toggle {
    position: fixed;
    top: 1rem;
    left: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    cursor: pointer;
    z-index: 100;
    backdrop-filter: blur(14px) saturate(180%);
    -webkit-backdrop-filter: blur(14px) saturate(180%);
    box-shadow: var(--glass-shadow);
    color: var(--text-primary);
  }

  .icon {
    position: absolute;
  }

  .icon-moon {
    display: none;
  }

  :global([data-theme="dark"]) .icon-sun {
    display: none;
  }

  :global([data-theme="dark"]) .icon-moon {
    display: block;
  }
</style>
