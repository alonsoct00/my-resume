---
import { basics as basics_es } from "@cv"
import { basics as basics_en } from "@cv_en"
import { seoDescriptions, seoTitle } from "@/lib/seo"
---

<div class="lang-switch no-print" id="lang-switch">
  <button data-lang-btn="es" data-seo-title={seoTitle(basics_es.name, basics_es.label)} data-seo-description={seoDescriptions.es} title="Español">ES</button>
  <span>|</span>
  <button data-lang-btn="en" data-seo-title={seoTitle(basics_en.name, basics_en.label)} data-seo-description={seoDescriptions.en} title="English">EN</button>
</div>

<script>
  declare global {
    interface Window {
      dataLayer: any[];
    }
  }

  type Lang = "es" | "en";

  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-lang-btn]");
  const htmlElement = document.documentElement;

  const getPreferredLang = (): Lang => {
    const saved = localStorage.getItem("cv-lang") as Lang | null;
    if (saved === "es" || saved === "en") return saved;
    
    return navigator.language.toLowerCase().startsWith("es") ? "es" : "en";
  };

  const updateMetaTags = (lang: Lang): void => {
    const button = document.querySelector<HTMLButtonElement>(`[data-lang-btn="${lang}"]`);
    const title = button?.dataset.seoTitle;
    const description = button?.dataset.seoDescription;
    if (title) {
      document.title = title;
      document.querySelector('meta[property="og:title"]')?.setAttribute("content", title);
      document.querySelector('meta[name="twitter:title"]')?.setAttribute("content", title);
    }
    if (description) {
      document.querySelector('meta[name="description"]')?.setAttribute("content", description);
      document.querySelector('meta[property="og:description"]')?.setAttribute("content", description);
      document.querySelector('meta[name="twitter:description"]')?.setAttribute("content", description);
    }
  };

  const applyLang = (lang: Lang): void => {
    // Atributos y LocalStorage
    htmlElement.setAttribute("data-lang", lang);
    htmlElement.setAttribute("lang", lang);
    localStorage.setItem("cv-lang", lang);

    updateMetaTags(lang);

    buttons.forEach((btn) => {
      btn.classList.toggle("active", btn.dataset.langBtn === lang);
    });

    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'change_language',
      language: lang
    });
  };

  // 3. Inicialización segura
  const initialLang = getPreferredLang();
  applyLang(initialLang);

  // 4. Listeners con casting de evento
  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const selected = btn.dataset.langBtn as Lang;
      if (selected) applyLang(selected);
    });
  });
</script>

<style>
  /* Mantenemos tus estilos originales */
  .lang-switch {
    position: fixed;
    top: 1rem;
    right: 1rem;
    display: flex;
    align-items: center;
    gap: 4px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    padding: 4px 10px;
    font-size: 0.75rem;
    font-weight: 600;
    z-index: 100;
    backdrop-filter: blur(14px) saturate(180%);
    -webkit-backdrop-filter: blur(14px) saturate(180%);
    box-shadow: var(--glass-shadow);
  }

  button {
    background: none;
    border: none;
    cursor: pointer;
    padding: 2px 4px;
    border-radius: 4px;
    color: var(--text-faint);
    font-size: 0.75rem;
    font-weight: 600;
    font-family: inherit;
    transition: color 0.2s;
  }

  button.active {
    color: var(--text-primary);
  }

  span {
    color: var(--text-faintest);
  }
</style>