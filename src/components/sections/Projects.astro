<script>
  const toolbars = document.querySelectorAll<HTMLElement>("[data-project-filters]");
  const grids = document.querySelectorAll<HTMLUListElement>("[data-project-grid]");

  function applyFilter(filter: string) {
    toolbars.forEach((toolbar) => {
      toolbar.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.filter === filter));
      });
      const select = toolbar.querySelector<HTMLSelectElement>("[data-project-select]");
      if (select) select.value = filter;
    });

    grids.forEach((grid) => {
      let count = 0;
      grid.querySelectorAll<HTMLLIElement>(":scope > li[data-categories]").forEach((card) => {
        const matches = filter === "all" || (card.dataset.categories ?? "").split(" ").includes(filter);
        card.hidden = !matches;
        if (matches) count++;
      });

      const toolbar = document.querySelector<HTMLElement>(
        `[data-project-filters="${grid.dataset.projectGrid}"]`,
      );
      const counter = toolbar?.querySelector<HTMLElement>("[data-project-count]");
      const empty = toolbar?.querySelector<HTMLElement>("[data-project-empty]");
      if (counter) counter.textContent = String(count);
      if (empty) empty.hidden = count !== 0;
    });
  }

  toolbars.forEach((toolbar) => {
    toolbar.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((button) => {
      button.addEventListener("click", () => {
        if (button.dataset.filter) applyFilter(button.dataset.filter);
      });
    });
    toolbar.querySelector<HTMLSelectElement>("[data-project-select]")?.addEventListener("change", (event) => {
      if (event.currentTarget instanceof HTMLSelectElement) applyFilter(event.currentTarget.value);
    });
    toolbar.hidden = false;
  });
  applyFilter("all");
</script>

