---
import Section from "../Section.astro";
import {
  projects as projects_es,
  designs as designs_es,
  vibecoding as vibecoding_es,
} from "@cv";
import {
  projects as projects_en,
  designs as designs_en,
  vibecoding as vibecoding_en,
} from "@cv_en";
import type { Designs, ProjectCategory, Vibecoding } from "@/cv";

type AstroIcon = (props?: any) => any;

const astroIcons = import.meta.glob<{ default: AstroIcon }>("@/icons/*.astro");
const svgIcons = import.meta.glob<string>("/public/icons/*.svg", {
  query: "?url",
  import: "default",
});

function slugify(name: string) {
  return name.toLowerCase().replace(/[\s.]/g, "").replace(/-/g, "");
}

async function getIcon(name: string) {
  const slug = slugify(name);

  const astroMatch = Object.entries(astroIcons).find(([path]) =>
    path.toLowerCase().includes(`/${slug}.astro`),
  );
  if (astroMatch) {
    const mod = await astroMatch[1]();
    return { type: "astro" as const, Component: mod.default };
  }

  const svgMatch = Object.entries(svgIcons).find(([path]) =>
    path.toLowerCase().includes(`/${slug}.svg`),
  );
  if (svgMatch) return { type: "svg" as const, url: await svgMatch[1]() };

  return null;
}

const FRAMEWORK_ICON_MAP: Record<string, string> = {
  astro: "astro",
  tailwindcss: "tailwindcss",
  tailwind: "tailwindcss",
  vuejs: "vuejs",
  vue: "vuejs",
  reactjs: "reactjs",
  react: "reactjs",
  nextjs: "nextjs",
  "next.js": "nextjs",
  bootstrap: "bootstrap",
  jquery: "jquery",
  javascript: "javascript",
  typescript: "typescript",
  shopify: "shopify",
  liquid: "liquid",
  bolt: "bolt",
  openai: "openai",
  lovable: "lovable",
  wordpress: "wordpress",
  WordPress: "wordpress",
  elementor: "elementor",
  Elementor: "elementor",
  claude: "claude",
  vercel: "vercel",
  Vercel: "vercel",
  scss: "scss",
  figma: "figma",
  vite: "vite",
  airtable: "airtable",
  resend: "resend",
  daisyui: "daisyui",
  seo: "seo",
  sitemap: "sitemap",
  "google ai studio": "googleaistudio"
};

async function getFrameworkIcons(highlights: string[]) {
  const found = new Set<string>();
  for (const h of highlights) {
    const lower = h.toLowerCase();
    for (const [keyword, iconName] of Object.entries(FRAMEWORK_ICON_MAP)) {
      if (lower.includes(keyword)) found.add(iconName);
    }
  }
  return await Promise.all(
    [...found].map(async (name) => ({
      name,
      icon: await getIcon(name),
    })),
  );
}

const GitHubIcon = await getIcon("github");
const WebflowIcon = await getIcon("webflow");
const ShopifyIcon = await getIcon("shopify");
const FigmaIcon = await getIcon("figma");

const resolvedProjects_es = await Promise.all(
  (projects_es as Array<{ shopify?: string } & (typeof projects_es)[0]>).map(
    async (project) => ({
      ...project,
      frameworkIcons: await getFrameworkIcons(project.highlights),
    }),
  ),
);

const resolvedProjects_en = await Promise.all(
  (projects_en as Array<{ shopify?: string } & (typeof projects_en)[0]>).map(
    async (project) => ({
      ...project,
      frameworkIcons: await getFrameworkIcons(project.highlights),
    }),
  ),
);

const projectFilters = ([
  { id: "all", es: "Todos", en: "All" },
  { id: "websites", es: "Sitios web", en: "Websites" },
  { id: "landing", es: "Landing Pages", en: "Landing Pages" },
  { id: "ecommerce", es: "eCommerce", en: "eCommerce" },
  { id: "shopify", es: "Shopify", en: "Shopify" },
  { id: "wordpress", es: "WordPress", en: "WordPress" },
  { id: "webflow", es: "Webflow", en: "Webflow" },
  { id: "webapp", es: "Aplicaciones web", en: "Web Apps" },
] satisfies Array<{ id: "all" | ProjectCategory; es: string; en: string }>).filter(({ id }) =>
  id === "all" || projects_es.some((project) => project.categories.includes(id)),
);

const resolvedDesigns_es = await Promise.all(
  (designs_es as Array<Designs>).map(async (design) => ({
    ...design,
    frameworkIcons: await getFrameworkIcons(design.highlights),
  })),
);

const resolvedDesigns_en = await Promise.all(
  (designs_en as Array<Designs>).map(async (design) => ({
    ...design,
    frameworkIcons: await getFrameworkIcons(design.highlights),
  })),
