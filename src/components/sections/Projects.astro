---
import Section from "../Section.astro";
import { projects as projects_es } from "@cv";
import { projects as projects_en } from "@cv_en";

type AstroIcon = (props?: any) => any;

const astroIcons = import.meta.glob<{ default: AstroIcon }>("@/icons/*.astro");
const svgIcons = import.meta.glob<string>("/public/icons/*.svg", {
  query: "?url",
  import: "default",
});

function slugify(name: string) {
  return name.toLowerCase().replace(/[\s.]/g, "").replace(/-/g, "");
}

async function getIcon(name: string) {
  const slug = slugify(name);

  const astroMatch = Object.entries(astroIcons).find(([path]) =>
    path.toLowerCase().includes(`/${slug}.astro`),
  );
  if (astroMatch) {
    const mod = await astroMatch[1]();
    return { type: "astro" as const, Component: mod.default };
  }

  const svgMatch = Object.entries(svgIcons).find(([path]) =>
    path.toLowerCase().includes(`/${slug}.svg`),
  );
  if (svgMatch) return { type: "svg" as const, url: await svgMatch[1]() };

  return null;
}

const FRAMEWORK_ICON_MAP: Record<string, string> = {
  astro: "astro",
  tailwindcss: "tailwindcss",
  tailwind: "tailwindcss",
  vuejs: "vuejs",
  vue: "vuejs",
  reactjs: "reactjs",
  react: "reactjs",
  nextjs: "nextjs",
  "next.js": "nextjs",
  bootstrap: "bootstrap",
  jquery: "jquery",
  javascript: "javascript",
  typescript: "typescript",
  shopify: "shopify",
  liquid: "liquid",
  bolt: "bolt",
  openai: "openai",
  lovable: "lovable",
};

async function getFrameworkIcons(highlights: string[]) {
  const found = new Set<string>();
  for (const h of highlights) {
    const lower = h.toLowerCase();
    for (const [keyword, iconName] of Object.entries(FRAMEWORK_ICON_MAP)) {
      if (lower.includes(keyword)) found.add(iconName);
    }
  }
  return await Promise.all(
    [...found].map(async (name) => ({
      name,
      icon: await getIcon(name),
    })),
  );
}

const GitHubIcon = await getIcon("github");
const WebflowIcon = await getIcon("webflow");
const ShopifyIcon = await getIcon("shopify");

const resolvedProjects_es = await Promise.all(
  (projects_es as Array<{ shopify?: string } & typeof projects_es[0]>).map(async (project) => ({
    ...project,
    frameworkIcons: await getFrameworkIcons(project.highlights),
  })),
)

const resolvedProjects_en = await Promise.all(
  (projects_en as Array<{ shopify?: string } & typeof projects_en[0]>).map(async (project) => ({
    ...project,
    frameworkIcons: await getFrameworkIcons(project.highlights),
  })),
)
---

<Section id="projects">
  <h2 data-lang-content="es">Proyectos y portafolio</h2>
  <h2 data-lang-content="en" aria-hidden="true">Projects & Portfolio</h2>

  <ul class="projects-grid" data-lang-content="es">
    {
      resolvedProjects_es.map(
        ({ url, description, highlights, name, isActive, github, webflow, shopify, frameworkIcons }) => {
          const GH = GitHubIcon?.type === "astro" ? GitHubIcon.Component : null;
          const WF = WebflowIcon?.type === "astro" ? WebflowIcon.Component : null;
          const SHP = ShopifyIcon?.type === "astro" ? ShopifyIcon.Component : null;
          return (
            <li>
              <article>
                <header>
                  <h3>
                    <a href={url} target="_blank" title={`Ver el proyecto ${name}`}>
                      {name}
                    </a>
                    {isActive && <span>•</span>}
                    {github && GH && (
                      <a class="github-code-link" href={github} target="_blank" title={`Código fuente ${name}`}>
                        <GH />
                      </a>
                    )}
                    {webflow && WF && (
                      <a class="webflow-code-link" href={webflow} target="_blank" title={`Webflow ${name}`}>
                        <WF />
                      </a>
                    )}
                    {shopify && SHP && (
                      <a class="shopify-code-link" href={shopify} target="_blank" title={`Shopify ${name}`}>
                        <SHP />
                      </a>
                    )}
                  </h3>
                  {frameworkIcons.length > 0 && (
                    <div class="framework-icons">
                      {frameworkIcons.map(({ name, icon }) => {
                        const Icon = icon?.type === "astro" ? icon.Component : null;
                        return (
                          (Icon || icon?.type === "svg") && (
                            <span title={name} class="framework-icon">
                              {Icon && <Icon />}
                              {icon?.type === "svg" && <img src={icon.url} alt={name} width="14" height="14" />}
                            </span>
                          )
                        );
                      })}
                    </div>
                  )}
                </header>
                <p>{description}</p>
                <footer>
                  <div class="highlights">
                    {highlights.map((h) => <span>{h}</span>)}
                  </div>
                </footer>
              </article>
            </li>
          );
        },
      )
    }
  </ul>

  <ul class="projects-grid" data-lang-content="en" aria-hidden="true">
    {
      resolvedProjects_en.map(
        ({ url, description, highlights, name, isActive, github, webflow, shopify, frameworkIcons }) => {
          const GH = GitHubIcon?.type === "astro" ? GitHubIcon.Component : null;
          const WF = WebflowIcon?.type === "astro" ? WebflowIcon.Component : null;
          const SHP = ShopifyIcon?.type === "astro" ? ShopifyIcon.Component : null;
          return (
            <li>
              <article>
                <header>
                  <h3>
                    <a href={url} target="_blank" title={`View project ${name}`}>
                      {name}
                    </a>
                    {isActive && <span>•</span>}
                    {github && GH && (
                      <a class="github-code-link" href={github} target="_blank" title={`Source code ${name}`}>
                        <GH />
                      </a>
                    )}
                    {webflow && WF && (
                      <a class="webflow-code-link" href={webflow} target="_blank" title={`Webflow ${name}`}>
                        <WF />
                      </a>
                    )}
                    {shopify && SHP && (
                      <a class="shopify-code-link" href={shopify} target="_blank" title={`Shopify ${name}`}>
                        <SHP />
                      </a>
                    )}
                  </h3>
                  {frameworkIcons.length > 0 && (
                    <div class="framework-icons">
                      {frameworkIcons.map(({ name, icon }) => {
                        const Icon = icon?.type === "astro" ? icon.Component : null;
                        return (
                          (Icon || icon?.type === "svg") && (
                            <span title={name} class="framework-icon">
                              {Icon && <Icon />}
                              {icon?.type === "svg" && <img src={icon.url} alt={name} width="14" height="14" />}
                            </span>
                          )
                        );
                      })}
                    </div>
                  )}
                </header>
                <p>{description}</p>
                <footer>
                  <div class="highlights">
                    {highlights.map((h) => <span>{h}</span>)}
                  </div>
                </footer>
              </article>
            </li>
          );
        },
      )
    }
  </ul>
</Section>

<style>
  #projects .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-inline: -16px;
  }

  .framework-icons {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    margin-top: 0.5rem;
  }

  .framework-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 4px;
    opacity: 0.8;
    transition: opacity 0.2s;
    padding: unset;
    background: rgba(0, 0, 0, 0.10);
  }

  .framework-icon:hover {
    opacity: 1;
  }

  .highlights {
    display: flex;
    gap: 8px;
    line-height: 16px;
  }
</style>