    <h2 data-lang-content="es">Proyectos y portafolio</h2>
    <h2 data-lang-content="en" aria-hidden="true">Projects & Portfolio</h2>

    <ul class="projects-grid" data-lang-content="es">
      {
        resolvedProjects_es.map(
          ({
            url,
            description,
            highlights,
            name,
            isActive,
            github,
            webflow,
            shopify,
            frameworkIcons,
          }) => {
            const GH =
              GitHubIcon?.type === "astro" ? GitHubIcon.Component : null;
            const WF =
              WebflowIcon?.type === "astro" ? WebflowIcon.Component : null;
            const SHP =
              ShopifyIcon?.type === "astro" ? ShopifyIcon.Component : null;
            return (
              <li>
                <article>
                  <header>
                    <h3>
                      <a
                        href={url}
                        target="_blank"
                        title={`Ver el proyecto ${name}`}
                      >
                        {name}
                      </a>
                      {isActive && <span>•</span>}
                      {github && GH && (
                        <a
                          class="github-code-link"
                          href={github}
                          target="_blank"
                          title={`Código fuente ${name}`}
                        >
                          <GH />
                        </a>
                      )}
                      {webflow && WF && (
                        <a
                          class="webflow-code-link"
                          href={webflow}
                          target="_blank"
                          title={`Webflow ${name}`}
                        >
                          <WF />
                        </a>
                      )}
                      {shopify && SHP && (
                        <a
                          class="shopify-code-link"
                          href={shopify}
                          target="_blank"
                          title={`Shopify ${name}`}
                        >
                          <SHP />
                        </a>
                      )}
                    </h3>
                    {frameworkIcons.length > 0 && (
                      <div class="framework-icons">
                        {frameworkIcons.map(({ name, icon }) => {
                          const Icon =
                            icon?.type === "astro" ? icon.Component : null;
                          return (
                            (Icon || icon?.type === "svg") && (
                              <span title={name} class="framework-icon">
                                {Icon && <Icon />}
                                {icon?.type === "svg" && (
                                  <img
                                    src={icon.url}
                                    alt={name}
                                    width="14"
                                    height="14"
                                  />
                                )}
                              </span>
                            )
                          );
                        })}
                      </div>
                    )}
                  </header>
                  <p>{description}</p>
                  <footer>
                    <div class="highlights">
                      {highlights.map((h) => (
