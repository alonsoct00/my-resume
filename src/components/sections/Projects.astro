const resolvedVibecoding_es = await Promise.all(
  (vibecoding_es as Array<Vibecoding>).map(async (project) => ({
    ...project,
    frameworkIcons: await getFrameworkIcons(project.highlights),
  })),
);

const resolvedVibecoding_en = await Promise.all(
  (vibecoding_en as Array<Vibecoding>).map(async (project) => ({
    ...project,
