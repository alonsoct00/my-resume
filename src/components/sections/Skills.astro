---
import Section from "../Section.astro"
import { skills as skills_es, languages as languages_es } from "@cv"
import { skills as skills_en, languages as languages_en } from "@cv_en"

const astroIcons = import.meta.glob<{ default: any }>('@/icons/*.astro')
const svgIcons = import.meta.glob<string>('/public/icons/*.svg', { query: '?url', import: 'default' })

function slugify(name: string) {
  return name.toLowerCase().replace(/[\s.]/g, "").replace(/-/g, "")
}

async function getIcon(name: string) {
  const slug = slugify(name)
  
  const astroMatch = Object.entries(astroIcons).find(([path]) =>
    path.toLowerCase().includes(`/${slug}.astro`)
  )
  if (astroMatch) {
    const mod = await astroMatch[1]()
    return { type: 'astro' as const, Component: mod.default }
  }

  const svgMatch = Object.entries(svgIcons).find(([path]) =>
    path.toLowerCase().includes(`/${slug}.svg`)
  )
  if (svgMatch) return { type: 'svg' as const, url: await svgMatch[1]() }

  return null
}

const resolvedSkills_es = await Promise.all(
  skills_es.map(async ({ name, level, keywords }) => ({
    name, level, keywords,
    icon: await getIcon(name)
  }))
)

const resolvedSkills_en = await Promise.all(
  skills_en.map(async ({ name, level, keywords }) => ({
    name, level, keywords,
    icon: await getIcon(name)
  }))
)
---

<Section id="skills">
  <h2 data-lang-content="es">Habilidades y conocimientos</h2>
  <h2 data-lang-content="en" aria-hidden="true">Skills & Knowledge</h2>

  <ul class="data-skills" data-lang-content="es">
    {resolvedSkills_es.map(({ name, level, keywords, icon }) => {
      const Icon = icon?.type === 'astro' ? icon.Component : null
      return (
        <li title={`${name} - ${level}`}>
          {(Icon || icon?.type === 'svg') && (
            <span class="icon-badge">
              {Icon && <Icon />}
              {icon?.type === 'svg' && <img src={icon.url} alt={name} width="14" height="14" />}
            </span>
          )}
          <span>{name}</span>
          <span class="keywords">{keywords.join(", ")}</span>
        </li>
      )
    })}
  </ul>

  <ul class="data-skills" data-lang-content="en" aria-hidden="true">
    {resolvedSkills_en.map(({ name, level, keywords, icon }) => {
      const Icon = icon?.type === 'astro' ? icon.Component : null
      return (
        <li title={`${name} - ${level}`}>
          {(Icon || icon?.type === 'svg') && (
            <span class="icon-badge">
              {Icon && <Icon />}
              {icon?.type === 'svg' && <img src={icon.url} alt={name} width="14" height="14" />}
            </span>
          )}
          <span>{name}</span>
          <span class="keywords">{keywords.join(", ")}</span>
        </li>
      )
    })}
  </ul>
</Section>

<Section id="languages_es" data-lang-content="es">
  <h2 data-lang-content="es">Idiomas</h2>
  <ul class="data-lang" data-lang-content="es">
    {languages_es.map(({ language, fluency }) => (
      <li>
        <p>{language}</p>
        <span>{fluency}</span>
      </li>
    ))}
  </ul>
</Section>

<Section id="languages_en" data-lang-content="en" aria-hidden="true">
  <h2 data-lang-content="en" aria-hidden="true">Languages</h2>
  <ul class="data-lang" data-lang-content="en" aria-hidden="true">
    {languages_en.map(({ language, fluency }) => (
      <li>
        <p>{language}</p>
        <span>{fluency}</span>
      </li>
    ))}
  </ul>
</Section>

<style>
  ul.data-skills, ul.data-lang {
    display: inline-flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .data-skills li, .data-lang li {
    align-items: center;
    background: var(--chip-bg);
    border-radius: 6px;
    color: var(--chip-text);
    display: inline-flex;
    font-size: 0.8rem;
    font-weight: 500;
    gap: 4px;
    padding: 0.2rem 0.6rem;
    margin-right: 8px;
    position: relative;
    min-height: 30px;
    width: auto;
  }

  .icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background: transparent;
    flex-shrink: 0;
  }

  .keywords {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>