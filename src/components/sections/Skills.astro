---
import Section from "../Section.astro"
import { skills as skills_es, languages as languages_es } from "@cv"
import { skills as skills_en, languages as languages_en } from "@cv_en"
import type { SkillCategory, Skills } from "@/cv"

const skillCategories = [
  { id: "frontend", es: "Desarrollo frontend", en: "Frontend Development" },
  { id: "ecommerce-cms", es: "eCommerce y CMS", en: "eCommerce & CMS" },
  { id: "tools-integrations", es: "Herramientas e integraciones", en: "Tools & Integrations" },
  { id: "ai-assisted", es: "Desarrollo asistido por IA", en: "AI-Assisted Development" },
] satisfies Array<{ id: SkillCategory; es: string; en: string }>

const iconAliases: Record<string, string> = { html5: "html", css3: "css" }

const languageFlags: Record<string, string> = { es: "🇲🇽", en: "🇺🇸" }

function getLanguageFlag(code: string) {
  const flag = languageFlags[code]
  if (!flag) throw new Error(`Unknown language flag: ${code}`)
  return flag
}

const astroIcons = import.meta.glob<{ default: any }>('@/icons/*.astro')
const svgIcons = import.meta.glob<string>('/public/icons/*.svg', { query: '?url', import: 'default' })

function slugify(name: string) {
  return name.toLowerCase().replace(/[\s.]/g, "").replace(/-/g, "")
}

async function getIcon(name: string) {
  const slug = iconAliases[slugify(name)] ?? slugify(name)
  
  const astroMatch = Object.entries(astroIcons).find(([path]) =>
    path.toLowerCase().includes(`/${slug}.astro`)
  )
  if (astroMatch) {
    const mod = await astroMatch[1]()
    return { type: 'astro' as const, Component: mod.default }
  }

  const svgMatch = Object.entries(svgIcons).find(([path]) =>
    path.toLowerCase().includes(`/${slug}.svg`)
  )
  if (svgMatch) return { type: 'svg' as const, url: await svgMatch[1]() }

  return null
}

async function resolveSkills(skills: Array<Omit<Skills, "category"> & { category: string }>) {
  return Promise.all(skills.map(async ({ name, level, keywords, category }) => {
    if (!skillCategories.some(({ id }) => id === category)) {
      throw new Error(`Unknown skill category: ${category}`)
    }
    return { name, level, keywords, category, icon: await getIcon(name) }
  }))
}

const resolvedSkills_es = await resolveSkills(skills_es)
const resolvedSkills_en = await resolveSkills(skills_en)
---

<Section id="skills">
  <h2 data-lang-content="es">Habilidades y conocimientos</h2>
  <h2 data-lang-content="en">Skills & Knowledge</h2>

  {([
    { lang: "es", skills: resolvedSkills_es },
    { lang: "en", skills: resolvedSkills_en },
  ] as const).map(({ lang, skills }) => (
    <div data-lang-content={lang}>
      {skillCategories.map(({ id, ...labels }) => (
        <div class="skill-group">
          <h3>{labels[lang]}</h3>
          <ul class="data-skills">
            {skills.filter(({ category }) => category === id).map(({ name, level, keywords, icon }) => {
              const Icon = icon?.type === 'astro' ? icon.Component : null
              return (
                <li title={level ? `${name} - ${level}` : undefined}>
                  {(Icon || icon?.type === 'svg') && (
                    <span class="icon-badge" data-icon={slugify(name)} aria-hidden="true">
                      {Icon && <Icon />}
                      {icon?.type === 'svg' && <img src={icon.url} alt="" width="14" height="14" />}
                    </span>
                  )}
                  <span>{name}</span>
                  {keywords.length > 0 && <span class="keywords">{keywords.join(", ")}</span>}
                </li>
              )
            })}
          </ul>
        </div>
      ))}
    </div>
  ))}
</Section>

<Section id="languages_es" data-lang-content="es">
  <h2 data-lang-content="es">Idiomas</h2>
  <ul class="data-lang" data-lang-content="es">
    {languages_es.map(({ code, language, fluency }) => (
      <li>
        <span aria-hidden="true">{getLanguageFlag(code)}</span>
        <p>{language}</p>
        <span>{fluency}</span>
      </li>
    ))}
  </ul>
</Section>

<Section id="languages_en" data-lang-content="en">
  <h2 data-lang-content="en">Languages</h2>
  <ul class="data-lang" data-lang-content="en">
    {languages_en.map(({ code, language, fluency }) => (
      <li>
        <span aria-hidden="true">{getLanguageFlag(code)}</span>
        <p>{language}</p>
        <span>{fluency}</span>
      </li>
    ))}
  </ul>
</Section>

<style>
  .skill-group + .skill-group {
    margin-top: 1.25rem;
  }

  .skill-group h3 {
    color: var(--text-heading);
    font-size: 0.875rem;
    margin-bottom: 0.6rem;
  }

  ul.data-skills, ul.data-lang {
    display: inline-flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  :global(html[data-lang="es"]) ul.data-lang[data-lang-content="es"],
  :global(html[data-lang="en"]) ul.data-lang[data-lang-content="en"] {
    display: flex !important;
  }

  .data-skills li, .data-lang li {
    align-items: center;
    background: var(--chip-bg);
    border-radius: 6px;
    color: var(--chip-text);
    display: inline-flex;
    font-size: 0.8rem;
    font-weight: 500;
    gap: 4px;
    padding: 0.2rem 0.6rem;
    margin-right: 8px;
    position: relative;
    min-height: 30px;
    width: auto;
  }

  .data-lang li {
    margin-right: 0;
  }

  .icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background: transparent;
    flex-shrink: 0;
  }

  .icon-badge[data-icon="nextjs"] :global(svg) {
    stroke: currentColor;
  }

  .icon-badge[data-icon="vercel"] :global(svg),
  .icon-badge[data-icon="resend"] :global(svg) {
    fill: currentColor;
  }

  :global([data-theme="dark"]) .icon-badge[data-icon="astro"] :global(path),
  :global([data-theme="dark"]) .icon-badge[data-icon="elementor"] :global(g),
  :global([data-theme="dark"]) .icon-badge[data-icon="less"] :global(svg) {
    fill: currentColor;
  }

  .keywords {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>